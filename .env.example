# No paid service is enabled by default. Download models once while online.
LLM_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
# Optional cloud mode. Choose a model currently available to YOUR free account.
GROQ_API_KEY=
GROQ_MODEL=
ENABLE_CLOUD_LLM=false
# Local embedding model; lexical mode is useful for a lightweight smoke test.
RETRIEVAL_MODE=semantic
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANK_ENABLED=false
MULTIQUERY_LLM=false
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# browser uses installed browser/system voices; edge sends response text online.
TTS_PROVIDER=browser
EDGE_VOICE=en-IN-NeerjaNeural
# Optional services; leave empty for a laptop-only app with SQLite memory.
REDIS_URL=
PHOENIX_ENDPOINT=
# Add exact HTTPS origins only if you intentionally expose the local server.
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Optional bearer token. Required before binding beyond loopback.
HAVEN_API_TOKEN=
DATA_DIR=data
SEED_SAMPLE_DATA=true
